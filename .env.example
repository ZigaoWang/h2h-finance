# Where the database and uploaded receipts live. Back this directory up.
DATA_DIR=./data

# Random string, at least 32 characters: `openssl rand -base64 48`
AUTH_SECRET=

# This address is made an admin on startup, so you can always get back in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Outgoing mail for sign-in codes. Without SMTP_HOST, codes are printed to the server log (development only).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="H2H Finance <finance@h2h.ykps.net>"
